# Copy to web/.env.local (gitignored). Use the SAME Supabase project as engine/.env.

# --- Public (safe to expose to the browser) ---
# The anon key is designed to be public; row-level security is what protects your data.
NEXT_PUBLIC_SUPABASE_URL=https://YOUR-PROJECT-REF.supabase.co
NEXT_PUBLIC_SUPABASE_ANON_KEY=

# --- Server only (never sent to the browser) ---
# service_role bypasses RLS — used only for provisioning demo membership. Keep it secret.
SUPABASE_URL=https://YOUR-PROJECT-REF.supabase.co
SUPABASE_SERVICE_ROLE_KEY=
