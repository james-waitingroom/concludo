# Copy to engine/.env and fill in. .env is gitignored.

# --- Anthropic (judgment proposer; the engine also falls back to ../spike/.env) ---
ANTHROPIC_API_KEY=
# ANTHROPIC_MODEL=claude-sonnet-5

# --- Supabase ---
# Project Settings → API. The Project URL and the two keys live there.
SUPABASE_URL=https://YOUR-PROJECT-REF.supabase.co
# service_role key — SERVER ONLY. Bypasses row-level security. Never expose to a browser.
SUPABASE_SERVICE_ROLE_KEY=
# anon (publishable) key — safe for a browser frontend, used with user auth + RLS.
SUPABASE_ANON_KEY=
