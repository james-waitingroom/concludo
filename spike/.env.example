# Copy this file to `.env` and fill in your key. `.env` is gitignored.
#
# Get a key at https://console.anthropic.com/settings/keys
# The spike runs in MOCK mode when this is unset, so you can run it without a key.
ANTHROPIC_API_KEY=

# Optional: override the extraction model (defaults to a current Claude model in code)
# ANTHROPIC_MODEL=claude-opus-4-8
